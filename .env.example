# Public site origin (metadata, sitemap, RSS canonical URLs).
SITE_URL=http://localhost:3000

# Development activity (npm run dev-activity, .github/workflows/dev-activity.yml).
# One pair per GitHub account: the username plus a read-only token for that account.
# Tokens must carry the read:user scope (gh auth refresh -s read:user) and query
# their own account; without read:user, private-repo contributions are counted but
# excluded from the commits/issues/prs/reviews split. Used server-side only —
# tokens never reach the browser.
GH_ACTIVITY_USER_1=
GH_ACTIVITY_TOKEN_1=
GH_ACTIVITY_USER_2=
GH_ACTIVITY_TOKEN_2=
GH_ACTIVITY_USER_3=
GH_ACTIVITY_TOKEN_3=
